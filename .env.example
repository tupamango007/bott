# Скопируйте в .env и заполните. Обязательны только первые три переменные.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Канал Discord для логов бота (необязательно)
LOG_CHANNEL_ID=

# Маршруты «чат Telegram → канал Discord»: tg_chat_id:discord_channel_id через запятую.
# Чаты из маршрутов автоматически разрешены. Остальное идёт в DISCORD_CHANNEL_ID.
ROUTES=

# Белые списки (ID через запятую). Пусто — без ограничений.
ALLOWED_USERS=
# Группы, из которых пересылать. Если пусто — пересылаются только личные сообщения боту.
ALLOWED_CHATS=
# Пересылать ли личные сообщения, когда заданы ALLOWED_CHATS/ROUTES (по умолчанию нет)
ALLOW_PRIVATE=

# ID пользователей Telegram, которым доступны команды /pause, /ban и т.д.
# Если пусто — команды администратора в Telegram недоступны никому.
ADMIN_IDS=

# Изначальный чёрный список (дальше управляется командами /ban и /unban)
BANNED_USERS=
# Стоп-слова (изначальные, дальше — /addword и /removeword)
IGNORE_WORDS=спам,реклама
# Сообщения со ссылками на эти домены не пересылаются
BLOCKED_DOMAINS=example.com,bad-site.net,spam-link.org
# Удалять ли ссылки из текста (1/0)
STRIP_LINKS=1

# Префикс перед именем отправителя и префикс текстовых команд Discord
MESSAGE_PREFIX=📢
COMMAND_PREFIX=!

# Лимит размера файла в МБ (0 — по лимиту сервера Discord, но не больше 20 МБ)
MAX_FILE_SIZE_MB=0
# Сколько секунд ждать остальные фото альбома
ALBUM_TIMEOUT=1.0

# Антифлуд: не больше N сообщений от одного пользователя за окно в секундах (0 — выключено)
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=60

# Отправлять через вебхук от имени автора из Telegram (нужно право «Управлять вебхуками»)
USE_WEBHOOK=0
# Ответы в Discord на пересланные сообщения отправлять обратно в Telegram
TWO_WAY=0

# Файл для чёрного списка, стоп-слов, статистики и связей сообщений
STATE_FILE=bot_state.json
# Порт веб-сервера (/ и /health)
PORT=8080
